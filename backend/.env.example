# ── Configuración del backend (copiar a .env y completar) ─────────────────────

# Puerto en el que escucha el servidor Express.
PORT=3001

# Entorno de ejecución: development | production
NODE_ENV=development

# Conexión a PostgreSQL (Prisma). Formato:
# postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bienestar_animal?schema=public"

# Secreto para firmar los JWT. Usar una cadena larga y aleatoria en producción.
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Tiempo de expiración de los tokens (ej: 8h, 1d, 30m).
JWT_EXPIRES_IN=8h

# Orígenes permitidos por CORS (separados por coma).
# 8100 = `ionic serve` · 5173 = `vite` (npm run dev)
CORS_ORIGIN=http://localhost:8100,http://localhost:5173
